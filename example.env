# splatoon-3 — example configuration.
# Copy to ".env" and fill in real values. NEVER commit your real .env.

# --- Listeners ---
NPLN_LISTEN=:7443
NPLN_GAMESYNC_LISTEN=:7575
NPLN_HTTP_LISTEN=:7444
NPLN_H2C_LISTEN=:8080
NPLN_DASH_LISTEN=:8089

# --- TLS ---
# The game pins hostnames under *.npln.srv.nintendo.net; your certificate must cover
# the tenant host it resolves, and gamesync.npln.nintendo.net for the session host.
CERT_FILE=cert.pem
KEY_FILE=key.pem

# --- Session relay / NAT traversal ---
# Public address the game is told to reach for the session host, STUN, TURN and the
# latency probes. Defaults are loopback so a fresh clone never points at someone else.
NPLN_RELAY_HOST=127.0.0.1
NPLN_RELAY_NAME=gamesync.npln.srv.nintendo.net
NPLN_STUN_HOST=127.0.0.1
NPLN_TURN_HOST=127.0.0.1
NPLN_TURN_SECRET=
NPLN_LATENCY_HOST=127.0.0.1

# --- Nextendo account integration ---
# Official Nextendo account backend, reachable on the trusted private service network.
# The game server calls /internal/npln-friends, not the public account-page frontend.
NEXTENDO_ACCOUNT_URL=http://nextendo-account:8080
NEXTENDO_INTERNAL_KEY=
NEXTENDO_UGC_BASE=
# Shared secret used to verify our own signed client tokens. Without it every identity
# collapses to pid=0 — set it, or point NEXTENDO_SECRET_FILE at a key file.
NEXTENDO_SECRET=
NEXTENDO_SECRET_FILE=/data/nextendo_secret.key
NPLN_AUTH_HMAC_SECRET=
# 1 = skip email verification only for an otherwise proven, existing account.
# It never bypasses identity proof, account lookup, bans, or disabled-account status.
# Keep empty in production.
NPLN_ALLOW_UNVERIFIED=

# --- Storage ---
NPLN_SAVE_DIR=/data/saves
# Optional override; by default bans persist in $NPLN_SAVE_DIR/bans.json.
NPLN_BAN_FILE=
NPLN_FLAGS_FILE=/data/soir.flags

# --- Measured responses (NOT shipped with this repository) ---
# Where to find your own "captured/" and "captured_boot/" directories, if you have them.
# Absent is fine: every consumer degrades gracefully and says so. See captures.go.
NPLN_CAPTURES_DIR=.

# --- Splatfest ---
# 1 = announce a Splatfest at all.
NPLN_S3_FEST=0

# --- Dashboard ---
DASH_TOKEN=
